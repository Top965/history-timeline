# Copy to .env.local for local development.

# Supabase Postgres connection string. On Vercel use the pooled "Transaction"
# string from Supabase (Project Settings > Database > Connection string), port 6543,
# and add ?sslmode=require. The app only reads, as the `anon` role, under RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/history_timeline

# Optional
# DATABASE_POOL_MAX=5
# LOG_LEVEL=info            # trace | debug | info | warn | error | silent
# NEXT_PUBLIC_SITE_URL=https://example.com
